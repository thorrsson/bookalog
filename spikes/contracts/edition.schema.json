{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bookalog.invalid/spikes/edition",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "work_id", "title", "format", "isbn13", "publication_status", "release_date", "contributors", "categories", "description", "cover_key", "revision"],
  "properties": {
    "id": { "$ref": "#/definitions/uuid" },
    "work_id": { "$ref": "#/definitions/uuid" },
    "title": { "type": "string", "minLength": 1, "maxLength": 500 },
    "format": { "enum": ["paperback", "hardback", "ebook", "audio"] },
    "isbn13": { "type": ["string", "null"], "pattern": "^97[89][0-9]{10}$" },
    "publication_status": { "enum": ["planned", "announced", "released", "out_of_print"] },
    "release_date": { "type": ["string", "null"], "pattern": "^[1-9][0-9]{3}(-[0-9]{2}(-[0-9]{2})?)?$" },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 300 },
          "role": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "description": { "type": "string", "maxLength": 100000 },
    "cover_key": { "type": ["string", "null"] },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "definitions": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
